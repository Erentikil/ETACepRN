{
  "expo": {
    "name": "ETA Mobil Pro",
    "slug": "etamobilpro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.horizonyazilim.etamobilpro",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSCameraUsageDescription": "Barkod okumak için kamera gereklidir.",
        "LSApplicationQueriesSchemes": [
          "tel",
          "telprompt",
          "whatsapp",
          "sms",
          "mailto",
          "maps",
          "comgooglemaps",
          "yandexmaps",
          "tel",
          "telprompt",
          "whatsapp",
          "sms",
          "mailto",
          "maps",
          "comgooglemaps",
          "yandexmaps"
        ]
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#000000"
      },
      "package": "com.horizonyazilim.etamobilpro",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.CAMERA"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "105eb735-4ba2-4592-a9af-c4f613b2087e"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "owner": "erentikik",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/105eb735-4ba2-4592-a9af-c4f613b2087e"
    }
  }
}
